            "url": { "raw": "{{baseUrl}}/api/v1/admin/prompts/exposure_analyst/canary-metrics", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","prompts","exposure_analyst","canary-metrics"] },
            "description": "Replace role_id in path. Valid IDs: exposure_analyst, historical_context, anomaly_detector, recommendation_synthesizer, narrative_writer, morning_brief_analyst, watchlist_analyst, earnings_analyst, qa_analyst, recommendation_judge, factuality_judge, calibration_judge, event_classifier, ticker_extractor, sentiment_analyzer"
          }
        }
      ]
    },

    {
      "name": "Evaluation",
      "description": "Requires role=admin",
      "item": [
        {
          "name": "List Evaluation Results",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/evaluation/results?limit=100",
              "host": ["{{baseUrl}}"], "path": ["api","v1","evaluation","results"],
              "query": [{ "key": "limit", "value": "100", "description": "1-1000" }]
            }
          }
        },
        {
          "name": "Insert Evaluation Result",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"run_id\": \"{{runId}}\",\n  \"metric_name\": \"factuality\",\n  \"score\": 0.92,\n  \"notes\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/evaluation/results", "host": ["{{baseUrl}}"], "path": ["api","v1","evaluation","results"] }
          }
        },
        {
          "name": "Get Results for Run",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/evaluation/results/{{runId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","evaluation","results","{{runId}}"] }
          }
        },
        {
          "name": "List Golden Dataset",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/evaluation/golden-dataset", "host": ["{{baseUrl}}"], "path": ["api","v1","evaluation","golden-dataset"] }
          }
        },
        {
          "name": "List Golden Dataset Candidates",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/evaluation/golden-dataset/candidates", "host": ["{{baseUrl}}"], "path": ["api","v1","evaluation","golden-dataset","candidates"] }
          }
        },
        {
          "name": "Create Golden Dataset Candidate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {},\n  \"expected_output\": {},\n  \"notes\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/evaluation/golden-dataset", "host": ["{{baseUrl}}"], "path": ["api","v1","evaluation","golden-dataset"] }
          }
        },
        {
          "name": "Approve Golden Dataset Item",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/v1/evaluation/golden-dataset/{{briefId}}/approve", "host": ["{{baseUrl}}"], "path": ["api","v1","evaluation","golden-dataset","{{briefId}}","approve"] }
          }
        },
        {
          "name": "Deactivate Golden Dataset Item",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/v1/evaluation/golden-dataset/{{briefId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","evaluation","golden-dataset","{{briefId}}"] }
          }
        },
        {
          "name": "List Calibration Results",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/evaluation/calibration?days=30",
              "host": ["{{baseUrl}}"], "path": ["api","v1","evaluation","calibration"],
              "query": [
                { "key": "days",          "value": "30", "description": "1-365" },
                { "key": "action_signal", "value": "",   "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Calibration Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/evaluation/calibration/summary?days=30",
              "host": ["{{baseUrl}}"], "path": ["api","v1","evaluation","calibration","summary"],
              "query": [{ "key": "days", "value": "30" }]
            },
            "description": "Returns assessment, rolling_corr, below_threshold flags."
          }
        },
        {
          "name": "Record Calibration Review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"corr_at_review\": 0.42,\n  \"below_threshold\": false,\n  \"action_taken\": \"no_action\",\n  \"notes\": \"Within acceptable range\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/evaluation/calibration/reviews", "host": ["{{baseUrl}}"], "path": ["api","v1","evaluation","calibration","reviews"] }
          }
        },
        {
          "name": "List Calibration Reviews",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/evaluation/calibration/reviews?limit=10",
