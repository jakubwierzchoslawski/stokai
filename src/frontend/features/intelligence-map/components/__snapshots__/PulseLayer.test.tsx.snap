// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Shader source strings > fragment shader snapshot is stable 1`] = `
"precision mediump float;
  varying vec4 v_color;
  varying float v_opacity;

  void main() {
    // Soft circular gradient using smoothstep on distance from center.
    vec2 coord = gl_PointCoord - vec2(0.5);
    float dist = length(coord);
    float alpha = smoothstep(0.5, 0.3, dist) * v_opacity;
    if (alpha < 0.01) discard;
    gl_FragColor = vec4(v_color.rgb, alpha);
  }"
`;

exports[`Shader source strings > vertex shader snapshot is stable 1`] = `
"precision highp float;
  attribute vec2 a_pos;
  attribute float a_radius;
  attribute vec4 a_color;
  attribute float a_opacity;

  uniform mat4 u_matrix;
  varying vec4 v_color;
  varying float v_opacity;

  void main() {
    gl_Position = u_matrix * vec4(a_pos, 0.0, 1.0);
    gl_PointSize = a_radius * 2.0;
    v_color = a_color;
    v_opacity = a_opacity;
  }"
`;
