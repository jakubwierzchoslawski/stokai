    {
      "name": "Admin — Data Sources",
      "description": "Requires role=admin",
      "item": [
        {
          "name": "List Data Sources",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/sources", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","sources"] },
            "description": "Includes health stats per source: calls_today, errors_today, rate_limit_pct_used, estimated_cost_today."
          }
        },
        {
          "name": "Create Data Source",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Finnhub\",\n  \"interface_type\": \"price\",\n  \"credentials_ref\": \"env:FINNHUB_API_KEY\",\n  \"config\": {},\n  \"cost_tier\": \"low\",\n  \"priority\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/sources", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","sources"] },
            "description": "credentials_ref format: `env:VAR_NAME` or `vault:PATH`. cost_tier: free | low | medium | high. New sources start disabled."
          }
        },
        {
          "name": "Get Data Source",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/sources/{{sourceId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","sources","{{sourceId}}"] }
          }
        },
        {
          "name": "Enable / Disable Source",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/sources/{{sourceId}}/enable", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","sources","{{sourceId}}","enable"] },
            "description": "Triggers synchronous registry refresh."
          }
        },
        {
          "name": "Get Source Health Stats",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/sources/{{sourceId}}/health", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","sources","{{sourceId}}","health"] }
          }
        },
        {
          "name": "List Market Bindings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/bindings", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","bindings"] }
          }
        },
        {
          "name": "Upsert Market Binding",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"market_id\": \"us_equities\",\n  \"interface_type\": \"price\",\n  \"source_id\": \"{{sourceId}}\",\n  \"role\": \"primary\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/bindings", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","bindings"] },
            "description": "role: primary | fallback. Triggers registry refresh."
          }
        },
        {
          "name": "Delete Market Binding",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"market_id\": \"us_equities\",\n  \"interface_type\": \"price\",\n  \"source_id\": \"{{sourceId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/bindings", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","bindings"] }
          }
        }
      ]
    },

