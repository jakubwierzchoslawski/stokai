            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/system/cache/refresh", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","system","cache","refresh"] }
          }
        },
        {
          "name": "List Feature Flags",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/system/flags", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","system","flags"] }
          }
        },
        {
