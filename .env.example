# StokAI Environment Configuration
# Copy this file to .env and fill in all required values.
# NEVER commit .env to source control (it is in .gitignore).
# All secrets are loaded from environment variables only (P-06, 12-factor).

# ---------------------------------------------------------------------------
# REQUIRED: Generate a strong random secret before deploying
# Example: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-in-production-generate-with-secrets-token-hex-32

# ---------------------------------------------------------------------------
# JWT configuration (safe defaults)
# ---------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Password hashing — cost factor >= 10 (DEV-STANDARDS §8, REQ-N-007)
# Default 12 is safe. Higher values increase login latency.
# ---------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Database
# Replace with your actual PostgreSQL 16 connection string.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://stokai:stokai@localhost:5432/stokai

# ---------------------------------------------------------------------------
# Test database (used by pytest integration tests)
# Must be a SEPARATE database from DATABASE_URL to avoid data loss.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql+asyncpg://stokai:stokai@localhost:5432/stokai_test

# ---------------------------------------------------------------------------
# Provider registry (hot-reload via PostgreSQL LISTEN/NOTIFY)
# ---------------------------------------------------------------------------
PROVIDER_REGISTRY_PG_CHANNEL=provider_registry_updates
PROVIDER_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Mode A Pipeline — PLAN-F-001
# ---------------------------------------------------------------------------

# Deduplication window in seconds (Redis SETEX TTL, default 1 hour).
DEDUP_TTL_SECONDS=3600

# Celery queue names (must match celery_worker configuration in docker-compose).
PIPELINE_QUEUE=event_pipeline
DEEP_DIVE_QUEUE=event_deep_dive

# Path to the classify-event agent YAML config (relative to project root).
CLASSIFY_MODEL_YAML=agents/classify_event.yaml

# Twitter/X toggle.
# IMPORTANT: This is a STUB adapter in MVP. No live API connection is made.
# Set to true only after implementing a real TwitterAdapter (C-002).
# Default: false (OFF).
TWITTER_ENABLED=false

# Confidence routing thresholds (C-003).
# Changing these requires operator approval — document the change.
AUTO_SEND_THRESHOLD=0.7
HIL_THRESHOLD=0.4

# GDELT v2 API endpoint.
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc?query=conflict&mode=artlist&maxrecords=250&format=json

# SEC EDGAR ATOM feed URL.
EDGAR_FEED_URL=https://www.sec.gov/cgi-bin/browse-edgar?action=getcurrent&type=10-K&dateb=&owner=include&count=40&output=atom

# EDGAR polling interval in seconds (default 300 = 5 minutes, satisfies AC-003 < 20 min SLA).
EDGAR_POLL_INTERVAL_SECONDS=300

# Alert disclaimer text (appended to all auto-generated alert copy).
# Do NOT remove — required for compliance (ARCHITECTURE.md §14).
ALERT_DISCLAIMER=For informational purposes only. Not investment advice. Past analogues do not guarantee future outcomes.

# ---------------------------------------------------------------------------
# Langfuse Observability — PLAN-F-013 (ARCHITECTURE.md §12)
# Self-hosted Langfuse instance started via docker compose up.
# ---------------------------------------------------------------------------

# Host URL of the Langfuse server (used by the StokAI API and worker).
# In Docker Compose: http://langfuse-server:3000
# For local development outside Docker: http://localhost:3000
LANGFUSE_HOST=http://localhost:3000

# Langfuse project credentials — generated by Langfuse on first boot or via UI.
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY and LANGFUSE_INIT_PROJECT_SECRET_KEY must match
# the values set in LANGFUSE_INIT_PROJECT_PUBLIC_KEY / SECRET_KEY below.
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me

# Deployment environment label used by PromptVersionResolver (default: production).
# Valid values: production | staging | development
LANGFUSE_ENVIRONMENT=production

# Prompt version cache TTL in seconds.
# Controls rollback latency: re-labelling a version in Langfuse UI takes effect
# within this many seconds — no app restart required (AC-006).
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Langfuse internal database (langfuse-db service — separate from StokAI DB)
# ---------------------------------------------------------------------------
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=change-me-generate-with-secrets-token-hex-32
LANGFUSE_DB_NAME=langfuse

# ---------------------------------------------------------------------------
# Langfuse server bootstrap — creates initial org/project on first boot.
# Generate UUIDs with: python -c "import uuid; print(uuid.uuid4())"
# ---------------------------------------------------------------------------
LANGFUSE_INIT_ORG_ID=change-me-uuid
LANGFUSE_INIT_PROJECT_ID=change-me-uuid
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-change-me

# NextAuth configuration for Langfuse UI authentication.
# NEXTAUTH_SECRET: generate with: python -c "import secrets; print(secrets.token_hex(32))"
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=change-me-generate-with-secrets-token-hex-32

# Langfuse UI port on the host machine.
LANGFUSE_PORT=3000

# ---------------------------------------------------------------------------
# ClickHouse — Langfuse analytics storage
# Memory limits keep container within C-001 budget ($100/month total).
# CLICKHOUSE_MAX_MEMORY_USAGE is in bytes (default: 1 GB = 1073741824).
# Increase for production; reduce for developer machines with limited RAM.
# ---------------------------------------------------------------------------
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_MAX_MEMORY_USAGE=1073741824
CLICKHOUSE_MAX_SERVER_MEMORY_USAGE_TO_RAM_RATIO=0.5

# ---------------------------------------------------------------------------
# Application secrets and connection strings (P-06, 12-factor)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Postgres credentials (used by compose init and app DATABASE_URL)
# ---------------------------------------------------------------------------
POSTGRES_USER=stokai
POSTGRES_PASSWORD=
POSTGRES_DB=stokai
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# AI providers (C-005: Anthropic-only default; no Azure OpenAI in MVP)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Memory decay (architecture §9, Decision D5)
# ---------------------------------------------------------------------------
MEMORY_DECAY_HALF_LIFE_DAYS=90
MEMORY_DECAY_FLOOR=0.1

# ---------------------------------------------------------------------------
# Scheduling (C-006: Morning Brief default 06:00 local, configurable per tenant)
# ---------------------------------------------------------------------------
MORNING_BRIEF_DEFAULT_TIME=06:00

# ---------------------------------------------------------------------------
# Provider registry config path (PLAN-F-002)
# ---------------------------------------------------------------------------
PROVIDER_REGISTRY_CONFIG_PATH=
