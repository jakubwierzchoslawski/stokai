            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/hil", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","hil"] },
            "description": "Sorted by scheduled_send_at ASC."
          }
        },
        {
          "name": "Get Pending HIL Count",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/hil/count", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","hil","count"] },
            "description": "Poll every 30 s for badge display."
          }
        },
        {
          "name": "Get HIL Item Detail",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/admin/hil/{{hilItemId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","hil","{{hilItemId}}"] }
          }
        },
        {
          "name": "Apply HIL Action",
          "request": {
