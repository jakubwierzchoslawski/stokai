# StokAI Environment Configuration
# Copy this file to .env and fill in all required values.
# NEVER commit .env to source control (it is in .gitignore).
# All secrets are loaded from environment variables only (P-06, 12-factor).

# ---------------------------------------------------------------------------
# REQUIRED: Generate a strong random secret before deploying
# Example: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-in-production-generate-with-secrets-token-hex-32

# ---------------------------------------------------------------------------
# JWT configuration (safe defaults)
# ---------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Password hashing — cost factor >= 10 (DEV-STANDARDS §8, REQ-N-007)
# Default 12 is safe. Higher values increase login latency.
# ---------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Database
# Replace with your actual PostgreSQL 16 connection string.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://stokai:stokai@localhost:5432/stokai

# ---------------------------------------------------------------------------
# Test database (used by pytest integration tests)
# Must be a SEPARATE database from DATABASE_URL to avoid data loss.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql+asyncpg://stokai:stokai@localhost:5432/stokai_test

# ---------------------------------------------------------------------------
# Provider registry (hot-reload via PostgreSQL LISTEN/NOTIFY)
# ---------------------------------------------------------------------------
PROVIDER_REGISTRY_PG_CHANNEL=provider_registry_updates
PROVIDER_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Mode A Pipeline — PLAN-F-001
# ---------------------------------------------------------------------------

# Deduplication window in seconds (Redis SETEX TTL, default 1 hour).
DEDUP_TTL_SECONDS=3600

# Celery queue names (must match celery_worker configuration in docker-compose).
PIPELINE_QUEUE=event_pipeline
DEEP_DIVE_QUEUE=event_deep_dive

# Path to the classify-event agent YAML config (relative to project root).
CLASSIFY_MODEL_YAML=agents/classify_event.yaml

# Twitter/X toggle.
# IMPORTANT: This is a STUB adapter in MVP. No live API connection is made.
# Set to true only after implementing a real TwitterAdapter (C-002).
# Default: false (OFF).
TWITTER_ENABLED=false

# Confidence routing thresholds (C-003).
# Changing these requires operator approval — document the change.
AUTO_SEND_THRESHOLD=0.7
HIL_THRESHOLD=0.4

# GDELT v2 API endpoint.
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc?query=conflict&mode=artlist&maxrecords=250&format=json

# SEC EDGAR ATOM feed URL.
EDGAR_FEED_URL=https://www.sec.gov/cgi-bin/browse-edgar?action=getcurrent&type=10-K&dateb=&owner=include&count=40&output=atom

# EDGAR polling interval in seconds (default 300 = 5 minutes, satisfies AC-003 < 20 min SLA).
EDGAR_POLL_INTERVAL_SECONDS=300

# Alert disclaimer text (appended to all auto-generated alert copy).
# Do NOT remove — required for compliance (ARCHITECTURE.md §14).
ALERT_DISCLAIMER=For informational purposes only. Not investment advice. Past analogues do not guarantee future outcomes.
