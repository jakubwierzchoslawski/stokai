              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/system/flags/TWITTER_ENABLED", "host": ["{{baseUrl}}"], "path": ["api","v1","admin","system","flags","TWITTER_ENABLED"] },
            "description": "Replace flag_id in path. Mutable at runtime — no restart needed."
