# ─────────────────────────────────────────────────────────────────────────────
# StokAI — environment variable catalogue
# Copy this file to .env, fill in every REPLACE_ME value, then run:
#   docker compose up
#
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=local                   # local | test | staging | production
DEBUG=false                         # Set to true only in development
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg DSN — change hostname/credentials when switching environments
DATABASE_URL=postgresql+asyncpg://stokai:REPLACE_ME@postgres:5432/stokai
DATABASE_POOL_SIZE=10               # SQLAlchemy connection pool size
DATABASE_MAX_OVERFLOW=5             # Extra connections above pool_size

# PostgreSQL container credentials (used by docker-compose.yml postgres service)
POSTGRES_USER=stokai
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=stokai

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0      # Main Redis DSN; Celery broker defaults here
# CELERY_BROKER_URL=               # Defaults to REDIS_URL if blank
# CELERY_RESULT_BACKEND=           # Defaults to REDIS_URL if blank

# ── AI Providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME  # Claude models (primary reasoning)
OPENAI_API_KEY=sk-REPLACE_ME         # OpenAI embeddings (text-embedding-3-small)

# ── External Integrations ──────────────────────────────────────────────────────
FINNHUB_API_KEY=                    # Optional; financial data feed (free tier available)
FMP_API_KEY=                        # Optional; Financial Modeling Prep API
SENDGRID_API_KEY=                   # Optional; email alerts disabled if blank
SENDGRID_FROM_EMAIL=                # Optional; must be set when alerts are enabled

# ── Morning Brief (PLAN-F-006) ────────────────────────────────────────────────
MORNING_BRIEF_DEFAULT_SEND_TIME=06:00     # Default dispatch time (HH:MM) per user (D7)
SENDGRID_MORNING_BRIEF_TEMPLATE_ID=       # SendGrid dynamic template ID for morning brief HTML

# ── Langfuse Observability ────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=REPLACE_ME      # Langfuse server secret (generates tokens)
LANGFUSE_PUBLIC_KEY=REPLACE_ME      # Langfuse public key for SDK tracing
LANGFUSE_HOST=http://langfuse-server:3000  # Self-hosted Langfuse URL

# Langfuse companion database credentials (langfuse-db service)
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=REPLACE_ME
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DATABASE_URL=postgresql://langfuse:REPLACE_ME@langfuse-db:5432/langfuse

# ClickHouse credentials (langfuse analytics store)
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=langfuse
CLICKHOUSE_URL=http://default:langfuse@clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://default:langfuse@clickhouse:9000

# Git commit SHA baked in at build time; used as prompt_version fallback when
# the container has no .git directory (PromptVersionResolver reads this).
PROMPT_SHA_FALLBACK=                # Set to $GIT_SHA in CI build args

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=REPLACE_ME_WITH_LONG_RANDOM_STRING          # Min 32 chars; signs access tokens
JWT_REFRESH_SECRET_KEY=REPLACE_ME_WITH_DIFFERENT_LONG_RANDOM_STRING  # Signs refresh tokens
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15  # Short-lived access token TTL
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30    # Long-lived refresh token TTL

# ── Filesystem paths ──────────────────────────────────────────────────────────
AGENTS_DIR=agents                   # Directory containing YAML agent definitions
PROMPTS_DIR=prompts                 # Directory containing Langchain/prompt templates

# ── Port Binding ──────────────────────────────────────────────────────────────
PORT=8000                           # Internal FastAPI port (inside container)
API_PORT=8000                       # External port published by docker compose

# ── Local dev overrides (docker-compose.override.yml only) ────────────────────
POSTGRES_PORT=5432                  # Host port for direct postgres access (local only)
REDIS_PORT=6379                     # Host port for direct redis access (local only)

# ── Seeding (optional — used by cold-start seed script) ──────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_ME_MIN_12_CHARS
SEED_TENANT_ID=00000000-0000-0000-0000-000000000001

# ── Cold-Start Historical Data Seeding (PLAN-F-031) ───────────────────────────
SEEDING_PROVIDER=gdelt              # 'gdelt' (default) or 'acled' (fallback)
GDELT_START_DATE=1979-01-01         # Start of GDELT historical archive (ISO date)
SEEDING_BATCH_SIZE=500              # Events per seeding batch (memory footprint)
EMBEDDING_CONCURRENCY=5             # Parallel OpenAI embedding calls per sub-batch;
                                    # reduce to 1 for strict rate-limit environments
ACLED_API_KEY=                      # Required only when SEEDING_PROVIDER=acled;
                                    # obtain from https://acleddata.com/register/

# ── AI Recommendation Accuracy Calibration (PLAN-N-010) ──────────────────────
CALIBRATION_CORR_THRESHOLD=0.3      # Min Pearson CORR(confidence, actual_t1d) for Healthy pass
CALIBRATION_MIN_SAMPLE=30           # Min total recs before threshold enforcement applies
