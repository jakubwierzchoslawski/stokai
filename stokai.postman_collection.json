{
  "info": {
    "name": "StokAI API",
    "description": "Complete API collection for the StokAI geopolitical intelligence platform.\n\n**Setup:**\n1. Set the `baseUrl` variable to `http://localhost:8000`\n2. Set `tenantId` to your tenant UUID\n3. Run **Auth / Login** — the collection script stores `accessToken` automatically\n4. All other requests use `{{accessToken}}` in the Bearer header\n\n**Tenant isolation:** Cross-tenant access returns 404 (not 403) by design.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",     "value": "http://localhost:8000",                        "type": "string" },
    { "key": "tenantId",    "value": "00000000-0000-0000-0000-000000000001",         "type": "string" },
    { "key": "accessToken", "value": "",                                              "type": "string" },
    { "key": "companyId",   "value": "00000000-0000-0000-0000-000000000002",         "type": "string" },
    { "key": "portfolioId", "value": "00000000-0000-0000-0000-000000000003",         "type": "string" },
    { "key": "positionId",  "value": "00000000-0000-0000-0000-000000000004",         "type": "string" },
    { "key": "eventId",     "value": "00000000-0000-0000-0000-000000000005",         "type": "string" },
    { "key": "briefId",     "value": "00000000-0000-0000-0000-000000000006",         "type": "string" },
    { "key": "ruleId",      "value": "00000000-0000-0000-0000-000000000007",         "type": "string" },
    { "key": "sessionId",   "value": "00000000-0000-0000-0000-000000000008",         "type": "string" },
    { "key": "runId",       "value": "00000000-0000-0000-0000-000000000009",         "type": "string" },
    { "key": "sourceId",    "value": "00000000-0000-0000-0000-000000000010",         "type": "string" },
    { "key": "hilItemId",   "value": "00000000-0000-0000-0000-000000000011",         "type": "string" },
    { "key": "proposalId",  "value": "00000000-0000-0000-0000-000000000012",         "type": "string" },
    { "key": "patternId",   "value": "00000000-0000-0000-0000-000000000013",         "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [

    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Public endpoint. No auth required."
          }
        }
      ]
    },

    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "if (json.data && json.data.access_token) {",
                "  pm.collectionVariables.set('accessToken', json.data.access_token);",
                "  console.log('accessToken saved');",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-ID",  "value": "{{tenantId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"changeme\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "description": "Rate limit: 10/min. Sets HttpOnly `refresh_token` cookie. Test script saves `accessToken` to collection variable."
          }
        },
        {
          "name": "Refresh Token",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "if (json.data && json.data.access_token) {",
                "  pm.collectionVariables.set('accessToken', json.data.access_token);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","refresh"] },
            "description": "Uses HttpOnly `refresh_token` cookie set by Login. Rate limit: 30/min."
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","logout"] },
            "description": "Clears the HttpOnly refresh_token cookie. Always returns 204."
          }
        }
      ]
    },

    {
      "name": "Portfolio",
      "item": [
        {
          "name": "Create Portfolio",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Portfolio\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/portfolios", "host": ["{{baseUrl}}"], "path": ["api","v1","portfolios"] }
          }
        },
        {
          "name": "List Portfolios",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/portfolios", "host": ["{{baseUrl}}"], "path": ["api","v1","portfolios"] }
          }
        },
        {
          "name": "Get Portfolio",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/portfolios/{{portfolioId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","portfolios","{{portfolioId}}"] }
          }
        },
        {
          "name": "Delete Portfolio",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/v1/portfolios/{{portfolioId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","portfolios","{{portfolioId}}"] }
          }
        },
        {
          "name": "Add Position",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticker\": \"AAPL\",\n  \"shares\": 100.5,\n  \"cost_basis\": 150.50,\n  \"source\": \"manual\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/portfolios/{{portfolioId}}/positions", "host": ["{{baseUrl}}"], "path": ["api","v1","portfolios","{{portfolioId}}","positions"] },
            "description": "`source`: manual | csv | broker"
          }
        },
        {
          "name": "List Positions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/portfolios/{{portfolioId}}/positions", "host": ["{{baseUrl}}"], "path": ["api","v1","portfolios","{{portfolioId}}","positions"] }
          }
        },
        {
          "name": "Delete Position",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/v1/portfolios/{{portfolioId}}/positions/{{positionId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","portfolios","{{portfolioId}}","positions","{{positionId}}"] }
          }
        },
        {
          "name": "CSV Import",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/portfolios/import?portfolio_id={{portfolioId}}",
              "host": ["{{baseUrl}}"], "path": ["api","v1","portfolios","import"],
              "query": [{ "key": "portfolio_id", "value": "{{portfolioId}}" }]
            },
            "description": "Max file size 1 MB. Returns import statistics."
          }
        }
      ]
    },

    {
      "name": "Watchlist",
      "item": [
        {
          "name": "Add to Watchlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_id\": \"{{companyId}}\",\n  \"ticker\": \"AAPL\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/watchlist", "host": ["{{baseUrl}}"], "path": ["api","v1","watchlist"] }
          }
        },
        {
          "name": "List Watchlist",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/watchlist", "host": ["{{baseUrl}}"], "path": ["api","v1","watchlist"] }
          }
        },
        {
          "name": "Remove from Watchlist",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/v1/watchlist/{{companyId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","watchlist","{{companyId}}"] }
          }
        }
      ]
    },

    {
      "name": "Onboarding",
      "item": [
        {
          "name": "Get Onboarding State",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/onboarding/state", "host": ["{{baseUrl}}"], "path": ["api","v1","onboarding","state"] }
          }
        },
        {
          "name": "Select Scoring Profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile_id\": \"{{portfolioId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/onboarding/profile", "host": ["{{baseUrl}}"], "path": ["api","v1","onboarding","profile"] }
          }
        },
        {
          "name": "Skip Onboarding",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/v1/onboarding/skip", "host": ["{{baseUrl}}"], "path": ["api","v1","onboarding","skip"] }
          }
        }
      ]
    },

    {
      "name": "Companies",
      "item": [
        {
          "name": "Get Company Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/companies/{{companyId}}/detail?price_interval=1d&price_from_days=90",
              "host": ["{{baseUrl}}"], "path": ["api","v1","companies","{{companyId}}","detail"],
              "query": [
                { "key": "profile_id",      "value": "",    "disabled": true, "description": "UUID, defaults to user's default profile" },
                { "key": "price_interval",  "value": "1d",  "description": "1d | 1h | 15m" },
                { "key": "price_from_days", "value": "90",  "description": "1-365" }
              ]
            },
            "description": "Returns fundamentals, score breakdown, active events, analysis history, and track record."
          }
        },
        {
          "name": "Trigger On-Demand Analysis",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/v1/companies/{{companyId}}/analysis", "host": ["{{baseUrl}}"], "path": ["api","v1","companies","{{companyId}}","analysis"] },
            "description": "Returns run_id (202). Subscribe via WebSocket /ws/workflow/{run_id} for progress."
          }
        }
      ]
    },

    {
      "name": "Screener",
      "item": [
        {
          "name": "Screen Companies",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filters\": {},\n  \"sort_column\": \"score\",\n  \"sort_dir\": \"desc\",\n  \"page_size\": 20,\n  \"cursor\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/screener", "host": ["{{baseUrl}}"], "path": ["api","v1","screener"] },
            "description": "POST used (not GET) to support complex filter payloads. Returns cursor-paginated results."
          }
        }
      ]
    },

    {
      "name": "Events & Progressive Disclosure",
      "item": [
        {
          "name": "Get Event Popup (Level 1)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/popup", "host": ["{{baseUrl}}"], "path": ["api","v1","events","{{eventId}}","popup"] },
            "description": "< 300 ms for cached events."
          }
        },
        {
          "name": "Get Event Side Panel (Level 2)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/side-panel", "host": ["{{baseUrl}}"], "path": ["api","v1","events","{{eventId}}","side-panel"] },
            "description": "Sparklines, historical analogies, AI rationale."
          }
        },
        {
          "name": "Get Event Audit Trail",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/audit-trail", "host": ["{{baseUrl}}"], "path": ["api","v1","events","{{eventId}}","audit-trail"] },
            "description": "Prompt SHA, reasoning chain, Langfuse trace link."
          }
        },
        {
          "name": "Get Event Deep Dive (Level 3)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/deep-dive", "host": ["{{baseUrl}}"], "path": ["api","v1","events","{{eventId}}","deep-dive"] },
            "description": "200 = ready, 202 = pending (poll every 5 s)."
          }
        },
        {
          "name": "Get Event Memo",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/memo", "host": ["{{baseUrl}}"], "path": ["api","v1","events","{{eventId}}","memo"] }
          }
        }
      ]
    },

    {
      "name": "Briefs",
      "item": [
        {
          "name": "List Briefs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/briefs?limit=20",
              "host": ["{{baseUrl}}"], "path": ["api","v1","briefs"],
              "query": [
                { "key": "type",   "value": "",    "disabled": true, "description": "earnings | watchlist_scan | morning" },
                { "key": "cursor", "value": "",    "disabled": true },
                { "key": "limit",  "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Brief Detail",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/briefs/{{briefId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","briefs","{{briefId}}"] }
          }
        },
        {
          "name": "Submit Brief Feedback",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"feedback_type\": \"thumbs_up\",\n  \"correction\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/briefs/{{briefId}}/feedback", "host": ["{{baseUrl}}"], "path": ["api","v1","briefs","{{briefId}}","feedback"] },
            "description": "`feedback_type`: thumbs_up | thumbs_down | edit. `correction` required when type=edit."
          }
        },
        {
          "name": "Get Latest Watchlist Scan Brief",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/briefs/watchlist", "host": ["{{baseUrl}}"], "path": ["api","v1","briefs","watchlist"] }
          }
        }
      ]
    },

    {
      "name": "Earnings Briefs",
      "item": [
        {
          "name": "List Earnings Briefs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/earnings-briefs?limit=20",
              "host": ["{{baseUrl}}"], "path": ["api","v1","earnings-briefs"],
              "query": [
                { "key": "date",  "value": "",    "disabled": true, "description": "ISO date filter e.g. 2024-01-15" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Earnings Brief Run",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/earnings-briefs/{{runId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","earnings-briefs","{{runId}}"] },
            "description": "Returns report + scenario_tree when status=COMPLETED."
          }
        },
        {
          "name": "Get Latest Earnings Brief for Company",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/companies/{{companyId}}/earnings-brief", "host": ["{{baseUrl}}"], "path": ["api","v1","companies","{{companyId}}","earnings-brief"] }
          }
        }
      ]
    },

    {
      "name": "Q&A",
      "item": [
        {
          "name": "Create QA Session",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "if (json.session_id) {",
                "  pm.collectionVariables.set('sessionId', json.session_id);",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/v1/qa/sessions", "host": ["{{baseUrl}}"], "path": ["api","v1","qa","sessions"] }
          }
        },
        {
          "name": "Ask Question (SSE Stream)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "text/event-stream" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is the geopolitical outlook for AAPL?\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/qa/sessions/{{sessionId}}/messages", "host": ["{{baseUrl}}"], "path": ["api","v1","qa","sessions","{{sessionId}}","messages"] },
            "description": "Server-Sent Events stream. Event types: chunk (text token), done (final answer), cost_limited ($0.40 ceiling hit), error."
          }
        }
      ]
    },

    {
      "name": "Alerts",
      "item": [
        {
          "name": "List Alerts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts?page=1&page_size=20",
              "host": ["{{baseUrl}}"], "path": ["api","v1","alerts"],
              "query": [
                { "key": "page",          "value": "1" },
                { "key": "page_size",     "value": "20" },
                { "key": "status",        "value": "", "disabled": true },
                { "key": "action_signal", "value": "", "disabled": true },
                { "key": "date_from",     "value": "", "disabled": true, "description": "ISO datetime" },
                { "key": "date_to",       "value": "", "disabled": true, "description": "ISO datetime" }
              ]
            }
          }
        }
      ]
    },

    {
      "name": "Alert Rules",
      "item": [
        {
          "name": "List Alert Rules",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/alert-rules", "host": ["{{baseUrl}}"], "path": ["api","v1","alert-rules"] }
          }
        },
        {
          "name": "Create Alert Rule",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Rule\",\n  \"conditions\": {}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/alert-rules", "host": ["{{baseUrl}}"], "path": ["api","v1","alert-rules"] }
          }
        },
        {
          "name": "Update Alert Rule",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Rule Name\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/alert-rules/{{ruleId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","alert-rules","{{ruleId}}"] }
          }
        },
        {
          "name": "Delete Alert Rule",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/v1/alert-rules/{{ruleId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","alert-rules","{{ruleId}}"] }
          }
        }
      ]
    },

    {
      "name": "Anti-Fatigue Settings",
      "item": [
        {
          "name": "Get Anti-Fatigue Settings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/settings/anti-fatigue", "host": ["{{baseUrl}}"], "path": ["api","v1","settings","anti-fatigue"] }
          }
        },
        {
          "name": "Update Anti-Fatigue Settings",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"daily_push_limit\": 10,\n  \"dedup_window_minutes\": 30,\n  \"quiet_hours_start\": \"22:00\",\n  \"quiet_hours_end\": \"07:00\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/settings/anti-fatigue", "host": ["{{baseUrl}}"], "path": ["api","v1","settings","anti-fatigue"] },
            "description": "All fields optional (PATCH). daily_push_limit >= 1, dedup_window_minutes >= 1, quiet hours must differ."
          }
        }
      ]
    },

    {
      "name": "Compliance",
      "item": [
        {
          "name": "Get Recommendation Track Record",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/compliance/track-record/{{companyId}}?limit=50",
              "host": ["{{baseUrl}}"], "path": ["api","v1","compliance","track-record","{{companyId}}"],
              "query": [{ "key": "limit", "value": "50", "description": "1-200" }]
            },
            "description": "Items with sample_size < threshold will have disclaimer_required=true."
          }
        }
      ]
    },

    {
      "name": "Memory",
      "item": [
        {
          "name": "Submit User Feedback",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recommendation_id\": \"{{runId}}\",\n  \"rating\": \"positive\",\n  \"comment\": \"Spot on analysis\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/memory/feedback", "host": ["{{baseUrl}}"], "path": ["api","v1","memory","feedback"] }
          }
        },
        {
          "name": "List Pending Proposals (Admin)",
          "request": {
            "method": "GET",
